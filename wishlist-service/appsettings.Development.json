{
  "Jwt": {
    "Issuer": "wishlist-user-service",
    "Audience": "wishlist-clients",
    "Key": "wishlist-super-secret-key-change-me-please"
  },
  "UserService": {
    "BaseUrl": "http://localhost:5001",
    "TimeoutSeconds": 2,
    "RetryCount": 2
  },
  "Wishlist": {
    "MaxItemsPerWishlist": 100
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "wishlist.events"
  },
  "Outbox": {
    "BatchSize": 20,
    "PollIntervalMilliseconds": 2000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
