{
  "ConnectionStrings": {
    "DefaultConnection": "Host=chat-db;Port=5432;Database=wishlist_chat;Username=wishlist;Password=wishlist"
  },
  "Jwt": {
    "Issuer": "wishlist-user-service",
    "Audience": "wishlist-clients",
    "Key": "wishlist-super-secret-key-change-me-please"
  },
  "UserService": {
    "BaseUrl": "http://user-service:8080",
    "TimeoutSeconds": 2,
    "RetryCount": 2
  },
  "WishlistService": {
    "BaseUrl": "http://wishlist-service:8080",
    "TimeoutSeconds": 2,
    "RetryCount": 2
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "Exchange": "wishlist.events",
    "Queue": "chat.wishlist-created"
  },
  "Outbox": {
    "BatchSize": 20,
    "PollIntervalMilliseconds": 2000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
